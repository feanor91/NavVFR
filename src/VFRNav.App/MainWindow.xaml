<Window x:Class="VFRNav.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        xmlns:local="clr-namespace:VFRNav.App"
        Title="MSFS Rhumb" Icon="Assets/VFRNav.ico" Width="1500" Height="950" Background="#0B2A55" Loaded="Ifr_Loaded">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#A9C4EE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Header">
            <Setter Property="Foreground" Value="#8FB4E8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel>
            <Expander x:Name="CommonPanel" IsExpanded="True" Margin="0,0,0,10" Foreground="#E8EEFC">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Commun" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="route, appareil, carte" Foreground="#8FB4E8" FontSize="11" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="4,2,0,0">
                <TextBlock Style="{StaticResource Header}" Text="ROUTE"/>
                <DataGrid x:Name="RouteGrid" SelectionChanged="RouteGrid_SelectionChanged" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" Height="190" CellEditEnding="RouteGrid_CellEditEnding"
                          SelectionMode="Single" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Alt (ft)" Binding="{Binding AltitudeFt, StringFormat=0, TargetNullValue=''}" Width="58"/>
                        <DataGridTextColumn Header="Lat" Binding="{Binding Lat, StringFormat=F4}" Width="56"/>
                        <DataGridTextColumn Header="Lon" Binding="{Binding Lon, StringFormat=F4}" Width="56"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding NoteMark}" Width="40" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="↑" Click="MoveUp_Click"/>
                    <Button Content="↓" Click="MoveDown_Click"/>
                    <Button Content="Supprimer" Click="Remove_Click"/>
                    <Button Content="Inverser" Click="Reverse_Click"/>
                    <Button Content="Effacer" Click="Clear_Click"/>
                    <Button Content="Ouvrir .pln" Click="Open_Click" ToolTip="Ouvre un plan de vol MSFS (.pln), de MSFS Rhumb ou d'un autre outil"/>
                    <Button Content="Enregistrer .pln" Click="Save_Click" ToolTip="Enregistre la route en plan de vol MSFS (.pln), avec les altitudes et les notes"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                           Text="Clic sur la carte : point tournant. Clic sur un terrain : ajout du terrain. Lat/Lon modifiables dans la liste."/>

                <TextBlock x:Name="WpNotesLabel" Style="{StaticResource Label}" Text="Notes du point (sélectionne un point de la route)"/>
                <TextBox x:Name="WpNotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="62" VerticalScrollBarVisibility="Auto" IsEnabled="False"
                         TextChanged="WpNotes_Changed" LostFocus="WpNotes_LostFocus"
                         ToolTip="Consignes, repères visuels, fréquences... Elles apparaissent sur la feuille de route et au survol du point."/>

                <TextBlock Style="{StaticResource Header}" Text="CONDITIONS"/>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="Déclinaison (°E +)"/><TextBox x:Name="VarBox" TextChanged="Param_Changed"/>
                        <CheckBox x:Name="AutoVarCheck" Content="auto (départ)" Foreground="#A9C4EE" FontSize="10" Margin="0,2,0,0" IsChecked="True" Click="AutoVar_Click"/></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Vent dir (°)"/><TextBox x:Name="WdirBox" TextChanged="Param_Changed"/></StackPanel>
                    <StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="Vent (kt)"/><TextBox x:Name="WspdBox" TextChanged="Param_Changed"/></StackPanel>
                </UniformGrid>
                <CheckBox x:Name="RangeCheck" Content="Cercle de portée autour du départ" Foreground="#E8EEFC" Margin="0,8,0,0" IsChecked="True" Click="Range_Click"
                          ToolTip="Distance que l'appareil actif peut parcourir avec tout son carburant à sa vitesse de croisière, sans vent et sans réserve."/>
                <TextBlock x:Name="RangeInfo" Style="{StaticResource Label}" TextWrapping="Wrap"/>

                <TextBlock Style="{StaticResource Header}" Text="PLAN DE VOL"/>
                <Button x:Name="PlanButton" Content="Calculer le plan de vol et la feuille de route" Click="CalculatePlan_Click"
                        Background="#0B5FB0" Foreground="White" Padding="8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="PlanStatus" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBlock Style="{StaticResource Header}" Text="SIMULATEUR"/>
                <TextBlock x:Name="SimStatus" Style="{StaticResource Label}" TextWrapping="Wrap" Text="Suivi de l'avion : démarrage..."/>
                <TextBlock x:Name="SimInfo" Foreground="#7FE3A0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <CheckBox x:Name="FollowCheck" Content="Centrer la carte sur l'avion" Foreground="#E8EEFC" Margin="0,6,0,0" IsChecked="True"/>

                <TextBlock Style="{StaticResource Header}" Text="FOND DE CARTE"/>
                <ComboBox x:Name="BaseMapBox" SelectionChanged="BaseMap_Changed">
                    <ComboBoxItem Content="Clair (Esri, sans clé)"/>
                    <ComboBoxItem Content="CARTO Positron (clé CARTO)"/>
                    <ComboBoxItem Content="CARTO Voyager (clé CARTO)"/>
                    <ComboBoxItem Content="Relief (OpenTopoMap)"/>
                    <ComboBoxItem Content="Rues (OpenStreetMap)"/>
                </ComboBox>

                <TextBlock Style="{StaticResource Header}" Text="BALISES"/>
                <CheckBox x:Name="NavVorCheck" Content="VOR (losange violet)" Foreground="#E8EEFC" Click="NavFilter_Click"/>
                <CheckBox x:Name="NavNdbCheck" Content="NDB / ADF (rond orange)" Foreground="#E8EEFC" Margin="0,3,0,0" Click="NavFilter_Click"/>
                <CheckBox x:Name="ReportCheck" Content="Points de report VFR (triangle jaune)" Foreground="#E8EEFC" Margin="0,3,0,0" Click="ReportFilter_Click"
                          ToolTip="Points de report des aérodromes, lus sur leurs cartes VAC (StormATC). Un clic sur un triangle l'ajoute à la route."/>
                <TextBlock x:Name="NavCount" Style="{StaticResource Label}"/>
                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Text="Un clic sur une balise l'ajoute à la route."/>

                <CheckBox x:Name="WxDotsCheck" Content="Pastilles météo (couleur = catégorie de vol)" Foreground="#E8EEFC" Margin="0,8,0,0" Click="WxDots_Click"/>
                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                           Text="Vert VFR · bleu MVFR · rouge IFR · violet LIFR · gris : pas de METAR. Contour doré : carte VAC disponible. Texte sous le code : visibilité."/>

                <TextBlock Style="{StaticResource Header}" Text="DONNÉES"/>
                <TextBlock Style="{StaticResource Label}" Text="Pays (code ISO)"/>
                <TextBox x:Name="CountryBox" MaxLength="2"/>
                <TextBlock Style="{StaticResource Label}" Text="Clé API OpenAIP (espaces aériens, optionnel)"/>
                <DockPanel>
                    <Button x:Name="KeyEditButton" DockPanel.Dock="Right" Content="Valider" Click="KeyEdit_Click" Margin="6,0,0,0" MinWidth="64"/>
                    <PasswordBox x:Name="KeyBox"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Label}" Text="Clé CARTO (fond de carte CARTO, optionnel)"/>
                <DockPanel>
                    <Button x:Name="CartoEditButton" DockPanel.Dock="Right" Content="Valider" Click="CartoEdit_Click" Margin="6,0,0,0" MinWidth="64"/>
                    <PasswordBox x:Name="CartoKeyBox"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Label}" Text="Clé ICAO API Data Service (NOTAM, optionnel)"/>
                <DockPanel>
                    <Button x:Name="NotamEditButton" DockPanel.Dock="Right" Content="Valider" Click="NotamEdit_Click" Margin="6,0,0,0" MinWidth="64"/>
                    <PasswordBox x:Name="NotamKeyBox"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Label}" Text="Dossier StormATC (vide = détection automatique)"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="…" Click="BrowseStorm_Click" Margin="6,0,0,0"/>
                    <TextBox x:Name="StormBox"/>
                </DockPanel>
                <Button Content="Recharger" Click="Reload_Click" Margin="0,8,0,0"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>
            <Expander x:Name="VfrPanel" IsExpanded="True" Margin="0,0,0,10" Foreground="#E8EEFC">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="VFR" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="vol à vue" Foreground="#8FB4E8" FontSize="11" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="4,2,0,0">
                <TextBlock Style="{StaticResource Header}" Text="APPAREIL VFR"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Gérer…" Click="VfrManage_Click" Margin="6,0,0,0" ToolTip="Créer, modifier, dupliquer ou supprimer des appareils"/>
                    <ComboBox x:Name="VfrAircraftBox" DisplayMemberPath="Name" SelectionChanged="VfrAircraft_Changed" VerticalAlignment="Top"/>
                </DockPanel>
                <TextBlock x:Name="VfrAircraftInfo" Foreground="#E8EEFC" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource Label}" Text="Croisière (ft)" ToolTip="Altitude de croisière par défaut. Chaque point de la route peut avoir la sienne (colonne Alt)."/>
                <TextBox x:Name="VfrAltBox" TextChanged="CruiseAlt_Changed" ToolTip="Altitude de croisière par défaut. Chaque point de la route peut avoir la sienne (colonne Alt)."/>

                <TextBlock Style="{StaticResource Header}" Text="VÉRIFICATION DE LA ROUTE"/>
                <TextBlock x:Name="LiveCheck" Foreground="#FFD479" FontSize="11.5" TextWrapping="Wrap"/>

                <TextBlock Style="{StaticResource Header}" Text="FILTRES TERRAINS"/>
                <CheckBox x:Name="FWithCode" Content="Avec code (LFPL, LF3126…)" Foreground="#E8EEFC" Click="Filter_Click"/>
                <CheckBox x:Name="FWithoutCode" Content="Sans code (FR-xxxx)" Foreground="#E8EEFC" Margin="0,3,0,0" Click="Filter_Click"/>
                <CheckBox x:Name="FVacOnly" Content="Seulement avec carte VAC" Foreground="#E8EEFC" Margin="0,3,0,0" Click="Filter_Click"/>
                <WrapPanel Margin="0,6,0,0">
                    <CheckBox x:Name="FLarge" Content="Grands" Foreground="#E8EEFC" Margin="0,0,12,0" Click="Filter_Click"/>
                    <CheckBox x:Name="FMedium" Content="Moyens" Foreground="#E8EEFC" Margin="0,0,12,0" Click="Filter_Click"/>
                    <CheckBox x:Name="FSmall" Content="Petits" Foreground="#E8EEFC" Click="Filter_Click"/>
                </WrapPanel>
                <TextBlock x:Name="FilterCount" Style="{StaticResource Label}"/>

                <CheckBox x:Name="ZoneHelpCheck" Content="Aide des zones en bas de la carte" Foreground="#E8EEFC" Margin="0,8,0,0" Click="ZoneHelp_Click"/>

                <TextBlock Style="{StaticResource Header}" Text="FILTRES ESPACES AÉRIENS"/>
                <CheckBox x:Name="ARestricted" Content="Zones R / D / P / TSA (rouge)" Foreground="#E8EEFC" Click="AirspaceFilter_Click"/>
                <CheckBox x:Name="AControlled" Content="CTR / TMA / CTA (bleu)" Foreground="#E8EEFC" Margin="0,3,0,0" Click="AirspaceFilter_Click"/>
                <CheckBox x:Name="ARadio" Content="RMZ / TMZ / ATZ (violet)" Foreground="#E8EEFC" Margin="0,3,0,0" Click="AirspaceFilter_Click"/>
                <CheckBox x:Name="ALeisure" Content="Planeur / ULM / parachutage (orange)" Foreground="#E8EEFC" Margin="0,3,0,0" Click="AirspaceFilter_Click"/>
                <CheckBox x:Name="ASectors" Content="FIR / secteurs FIS / autres (gris)" Foreground="#E8EEFC" Margin="0,3,0,0" Click="AirspaceFilter_Click"/>
                <DockPanel Margin="0,6,0,0">
                    <TextBox x:Name="AFloorBox" DockPanel.Dock="Right" Width="64" TextChanged="AirspaceFloor_Changed"/>
                    <CheckBox x:Name="AFloorCheck" Content="Masquer si plancher &gt; (ft)" Foreground="#E8EEFC" VerticalAlignment="Center" Click="AirspaceFloor_Changed"/>
                </DockPanel>
                <TextBlock x:Name="AirspaceCount" Style="{StaticResource Label}"/>
                </StackPanel>
            </Expander>
            <Expander x:Name="IfrPanel" IsExpanded="True" Margin="0,0,0,10" Foreground="#E8EEFC">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="IFR" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="vol aux instruments" Foreground="#8FB4E8" FontSize="11" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="4,2,0,0">
                <TextBlock Style="{StaticResource Header}" Text="APPAREIL IFR"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Gérer…" Click="IfrManage_Click" Margin="6,0,0,0" ToolTip="Créer, modifier, dupliquer ou supprimer des appareils"/>
                    <ComboBox x:Name="IfrAircraftBox" DisplayMemberPath="Name" SelectionChanged="IfrAircraft_Changed" VerticalAlignment="Top"/>
                </DockPanel>
                <TextBlock x:Name="IfrAircraftInfo" Foreground="#E8EEFC" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <TextBlock x:Name="IfrDataLabel" Foreground="#FFD479" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,2"/>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="Départ (OACI)"/>
                        <TextBox x:Name="IfrDepBox" Text="LFPG" CharacterCasing="Upper" TextChanged="IfrAirport_Changed"/></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Arrivée (OACI)"/>
                        <TextBox x:Name="IfrArrBox" Text="LFMN" CharacterCasing="Upper" TextChanged="IfrAirport_Changed"/></StackPanel>
                    <StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="Piste de départ"/>
                        <ComboBox x:Name="IfrDepRunwayBox" SelectionChanged="IfrRunway_Changed" ToolTip="Piste conseillée d'après le vent du METAR. Choisissez-en une autre pour la forcer ; « Auto » prend le trajet le plus court toutes pistes confondues."/></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="Piste d'arrivée"/>
                        <ComboBox x:Name="IfrArrRunwayBox" SelectionChanged="IfrRunway_Changed" ToolTip="Piste conseillée d'après le vent du METAR. Choisissez-en une autre pour la forcer ; « Auto » prend le trajet le plus court toutes pistes confondues."/></StackPanel>
                    <StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="SID"/>
                        <ComboBox x:Name="IfrSidBox"/></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource Label}" Text="STAR"/>
                        <ComboBox x:Name="IfrStarBox"/></StackPanel>
                    <StackPanel Margin="0,0,6,0"><TextBlock Style="{StaticResource Label}" Text="Croisière (FL)" ToolTip="Facultatif : écarte les routes ATS qui ne couvrent pas ce niveau. À partir du FL195, la route libre (tronçons directs) est autorisée."/>
                        <TextBox x:Name="IfrFlBox" TextChanged="CruiseAlt_Changed" ToolTip="Facultatif : écarte les routes ATS qui ne couvrent pas ce niveau."/></StackPanel>
                </UniformGrid>
                <TextBlock x:Name="IfrAirportInfo" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <Button Content="Charger les données AIRAC (SIA)…" Click="IfrLoad_Click" Margin="0,8,0,0"
                        ToolTip="Export AIXM 4.5 gratuit de la boutique du SIA : export_xml_bd_SIA_aaaa-mm-jj.zip. Il contient les routes ATS mais pas les SID/STAR."/>
                <Button x:Name="IfrSimButton" Content="Relire ces deux terrains dans MSFS (facultatif)" Click="IfrSim_Click" Margin="0,0,0,0"
                        ToolTip="Facultatif : les SID et STAR de tous les terrains sont déjà enregistrées, il suffit de saisir un autre code OACI. Ce bouton remet à jour tout de suite le départ et l'arrivée saisis, MSFS lancé."/>
                <Button x:Name="IfrSimAllButton" Content="Enregistrer / mettre à jour les SID/STAR du monde (MSFS)" Click="IfrSimAll_Click" Margin="0,0,0,0"
                        ToolTip="MSFS lancé : lit les SID et STAR de tous les terrains du simulateur et les enregistre dans les données de MSFS Rhumb (quelques minutes). Ensuite le calcul de route n'a plus besoin du simulateur. À refaire à la main quand MSFS met à jour ses données : seuls les terrains qui ont changé sont réécrits. Un second clic arrête la lecture."/>
                <Button x:Name="IfrNetworkButton" Content="Enregistrer / mettre à jour les routes ATS hors de France (MSFS)" Click="IfrNetwork_Click" Margin="0,0,0,0"
                        ToolTip="MSFS lancé : explore les routes ATS du monde de proche en proche, à partir des points des SID/STAR enregistrées, et les enregistre dans les données de MSFS Rhumb. La France reste celle du SIA. Long (jusqu'à une heure). Un second clic arrête la lecture sans rien enregistrer."/>
                <Button Content="Calculer la route IFR" Click="IfrCompute_Click" Margin="0,0,0,4"
                        ToolTip="Cherche le plus court chemin SID, routes ATS, STAR et remplace la route par le résultat."/>
                <TextBlock x:Name="IfrStatus" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                </StackPanel>
            </Expander>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" x:Name="Workspace">
            <Grid x:Name="MapHost">
                <mapsui:MapControl x:Name="MapControl"/>
                <Line x:Name="TipLeader" Visibility="Collapsed" IsHitTestVisible="False" Stroke="#1D4A8A" StrokeThickness="2"
                      HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border x:Name="MapTip" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="#F2FFFFFF" BorderBrush="#1D4A8A" BorderThickness="1" CornerRadius="4" Padding="8,6" MaxWidth="380">
                    <TextBlock x:Name="TipText" TextWrapping="Wrap" Foreground="#0B2A55" FontSize="12"/>
                </Border>
                <Border x:Name="ZoneHelp" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="10,10,10,24"
                        Background="#F5FFFFFF" BorderBrush="#1D4A8A" BorderThickness="1" CornerRadius="4" Padding="10,6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="✕" Padding="6,0" Margin="8,0,0,0"
                                Click="ZoneHelpClose_Click" ToolTip="Masquer : la fiche revient au prochain contour survolé (case à décocher dans le panneau de gauche pour la désactiver)"/>
                        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ZoneHelpText" TextWrapping="Wrap" Foreground="#0B2A55" FontSize="12.5"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                    <Button x:Name="LiveInfoButton" Content="Infos en direct" Margin="0,0,8,0" Width="132" Height="34"
                            Padding="12,6" Background="#0B2A55" Foreground="White" BorderBrush="#5AB0FF" FontWeight="SemiBold"
                            Click="LiveInfo_Click" ToolTip="Altitude du sol, météo et zones du point suivi, dans une fenêtre à part"/>
                    <Button x:Name="GlossaryButton" Content="Glossaire" Margin="0,0,8,0" Width="132" Height="34"
                            Padding="12,6" Background="#0B2A55" Foreground="White" BorderBrush="#5AB0FF" FontWeight="SemiBold"
                            Click="Glossary_Click" ToolTip="Sigles des cartes : TMA, CTR, QNH, RMZ…"/>
                    <Button x:Name="VacToggle" Content="Cartes VAC" Margin="0" Width="132" Height="34"
                            Padding="12,6" Background="#0B2A55" Foreground="White" BorderBrush="#5AB0FF" FontWeight="SemiBold"
                            Click="ToggleVac_Click" ToolTip="Afficher / masquer le lecteur de cartes VAC"/>
                </StackPanel>
            </Grid>
            <GridSplitter x:Name="SplitA" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#1D4A8A"/>
            <GridSplitter x:Name="SplitB" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#1D4A8A" Visibility="Collapsed"/>
            <GridSplitter x:Name="SplitV" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#1D4A8A" Visibility="Collapsed"/>
            <TabControl x:Name="BottomTabs" Grid.Row="2">
                <TabItem Header="Log de nav">
                    <DockPanel>
                        <TextBlock x:Name="TotalText" DockPanel.Dock="Bottom" Margin="6" FontWeight="Bold"/>
                        <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="De → A" Binding="{Binding Route}" Width="*"/>
                                <DataGridTextColumn Header="Dist (NM)" Binding="{Binding DistanceNm, StringFormat=F1}"/>
                                <DataGridTextColumn Header="Rv" Binding="{Binding TrueCourse, StringFormat=000°}"/>
                                <DataGridTextColumn Header="Rm" Binding="{Binding MagneticCourse, StringFormat=000°}"/>
                                <DataGridTextColumn Header="Dérive" Binding="{Binding WindCorrection, StringFormat=+0;-0;0}"/>
                                <DataGridTextColumn Header="Cm" Binding="{Binding MagneticHeading, StringFormat=000°}"/>
                                <DataGridTextColumn Header="GS (kt)" Binding="{Binding GroundSpeedKt, StringFormat=F0}"/>
                                <DataGridTextColumn Header="Temps" Binding="{Binding Time}"/>
                                <DataGridTextColumn Header="Carb (L)" Binding="{Binding FuelL, StringFormat=F1}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="METAR / TAF">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
                            <Button Content="Actualiser" Click="Weather_Click"/>
                            <CheckBox x:Name="WxRawCheck" Content="Afficher aussi le texte brut" VerticalAlignment="Center" Margin="8,0,0,6" Click="WxRaw_Click"/>
                        </StackPanel>
                        <TextBox x:Name="WxText" IsReadOnly="True" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="Ajoutez des terrains à la route puis cliquez sur Actualiser."/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="NOTAM">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="6,6,6,0">
                            <Button Content="Ouvrir SOFIA-Briefing (SIA)" Click="OpenSofia_Click"
                                    ToolTip="NOTAM officiels français, dans le navigateur (compte gratuit SIA)"/>
                            <Button Content="Copier les codes de la route" Click="CopyCodes_Click"/>
                            <Button Content="Actualiser (clé ICAO)" Click="Notam_Click"/>
                            <TextBlock Style="{StaticResource Label}" Margin="4,0,0,6" VerticalAlignment="Center"
                                       Text="ICAO : un appel par terrain, gardé 30 min (quota gratuit 100)."/>
                        </WrapPanel>
                        <TextBox x:Name="NotamText" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Text="NOTAM officiels : « Ouvrir SOFIA-Briefing » (navigateur, compte gratuit du SIA). Affichage direct ici : saisissez une clé ICAO (panneau Données) puis « Actualiser »."/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Profil">
                    <DockPanel>
                        <TextBlock x:Name="ProfileStatus" DockPanel.Dock="Top" Margin="8,4" Foreground="#0B2A55"
                                   Text="Relief sous la route, zones traversées et altitude de croisière : se remplit avec « Calculer le plan de vol »."/>
                        <local:ProfileChart x:Name="ProfileView" Margin="4"/>
                    </DockPanel>
                </TabItem>
            </TabControl>
            <Border x:Name="VacPanel" Visibility="Collapsed" Background="#0B2A55" BorderBrush="#1D4A8A" BorderThickness="1" Padding="6">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBox x:Name="IcaoBox" Width="90" Margin="0,0,6,6" KeyDown="IcaoBox_KeyDown" ToolTip="Code OACI ou nom"/>
                        <Button Content="Afficher" Click="ShowAerodrome_Click"/>
                        <Button Content="◀" Click="PrevPage_Click"/>
                        <TextBlock x:Name="PageText" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,6" Text="-"/>
                        <Button Content="▶" Click="NextPage_Click"/>
                        <Button Content="−" Click="ZoomOut_Click" ToolTip="Zoom arrière"/>
                        <Button Content="+" Click="ZoomIn_Click" ToolTip="Zoom avant"/>
                        <Button Content="Ajuster" Click="ZoomFit_Click" ToolTip="Ajuster à la largeur du panneau"/>
                        <Button x:Name="LargeButton" Content="Agrandir" Click="Large_Click"/>
                        <Button x:Name="DockButton" Content="Placer en bas" Click="Dock_Click"/>
                        <Button Content="Ajouter à la route" Click="AddAerodrome_Click"/>
                        <Button Content="Ouvrir le PDF" Click="OpenPdf_Click"/>
                        <Button Content="✕" Click="ToggleVac_Click" ToolTip="Masquer le lecteur"/>
                    </WrapPanel>
                    <Expander DockPanel.Dock="Top" Header="Infos terrain" Foreground="#A9C4EE" Margin="0,0,0,4">
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="InfoText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="#E8EEFC"
                                       Text="Saisissez un code OACI (LFPL) ou cliquez sur un terrain de la route."/>
                        </ScrollViewer>
                    </Expander>
                    <TextBlock x:Name="VacMessage" DockPanel.Dock="Top" Foreground="#F5C46B" TextWrapping="Wrap"/>
                    <ScrollViewer x:Name="VacScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#444" SizeChanged="VacScroll_SizeChanged">
                        <Image x:Name="VacImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
