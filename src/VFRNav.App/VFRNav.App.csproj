<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VFRNav.Core\VFRNav.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\VFRNav.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mapsui.Wpf" Version="5.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\VFRNav.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- SimConnect : VFRNav appelle la DLL native SimConnect.dll, sans référence au SDK à la compilation. Si le SDK de MSFS
       est sur la machine de compilation, la DLL est copiée à côté de l'exécutable (donc dans un installeur construit en
       local) ; sinon elle est cherchée au lancement (voir SimConnectTracker). C'est un binaire Microsoft : elle n'est pas
       versionnée et le workflow GitHub ne l'embarque pas. -->
  <PropertyGroup>
    <SimConnectNative Condition="'$(SimConnectNative)' == '' AND '$(MSFS_SIMCONNECT_PATH)' != ''">$([System.IO.Path]::GetFullPath('$([System.IO.Path]::GetDirectoryName($(MSFS_SIMCONNECT_PATH)))\..\SimConnect.dll'))</SimConnectNative>
    <SimConnectNative Condition="'$(SimConnectNative)' == '' AND Exists('C:\MSFS 2024 SDK\SimConnect SDK\lib\SimConnect.dll')">C:\MSFS 2024 SDK\SimConnect SDK\lib\SimConnect.dll</SimConnectNative>
    <SimConnectNative Condition="'$(SimConnectNative)' == '' AND Exists('C:\MSFS SDK\SimConnect SDK\lib\SimConnect.dll')">C:\MSFS SDK\SimConnect SDK\lib\SimConnect.dll</SimConnectNative>
  </PropertyGroup>

  <ItemGroup Condition="'$(SimConnectNative)' != '' AND Exists('$(SimConnectNative)')">
    <Content Include="$(SimConnectNative)" Link="SimConnect.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
